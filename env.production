# Production Environment Variables for Cloudflare Deployment
# استخدم هذا الملف للمتغيرات على الإنتاج

# Cloudflare Configuration
ENVIRONMENT=production
CLOUDFLARE_ACCOUNT_ID=YOUR_ACCOUNT_ID
CLOUDFLARE_ZONE_ID=YOUR_ZONE_ID
CLOUDFLARE_D1_DATABASE_ID=YOUR_DATABASE_ID

# Domain Configuration
DOMAIN=al-hiraf.com
API_DOMAIN=api.al-hiraf.com
CORS_ORIGIN=https://al-hiraf.com

# Database
DATABASE_URL=cloudflare:d1:al-hiraf-db
DATABASE_TYPE=d1

# Application Settings
TAX_RATE=0.15
INVOICE_PREFIX=INV
JOURNAL_PREFIX=JE

# Security
JWT_SECRET=your_jwt_secret_here
API_KEY=your_api_key_here

# Features
ENABLE_ANALYTICS=true
ENABLE_BACKUP=true
BACKUP_FREQUENCY=daily

# Logging
LOG_LEVEL=info
LOG_STORAGE=cloudflare:kv
